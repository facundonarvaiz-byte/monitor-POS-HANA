# ============================================
# Monitor POST vs HANA — Configuración
# ============================================

# --- HANA (SAP) — Producción ---
HANA_HOST=localhost
HANA_PORT=30015
HANA_USER=tu_usuario
HANA_PASSWORD=tu_contraseña
HANA_SCHEMA=tu_schema

# --- HANA (SAP) — Test (switch "Test" del dashboard) ---
HANA_TEST_HOST=hd0-db.cencosud.corp
HANA_TEST_PORT=30015
HANA_TEST_USER=tu_usuario_test
HANA_TEST_PASSWORD=tu_contraseña_test

# --- Autenticacion del dashboard (intranet) ---
GESTOR_PASS=gestor01
REVISOR_PASS=revisor01

# --- PostgreSQL (POST) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=post_db
POSTGRES_USER=tu_usuario
POSTGRES_PASSWORD=tu_contraseña

# --- Dashboard ---
STREAMLIT_PORT=8501
