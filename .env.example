# ============================================
# Monitor POST vs HANA — Configuración
# ============================================

# --- HANA (SAP) — Producción ---
HANA_HOST=localhost
HANA_PORT=30015
HANA_USER=tu_usuario
HANA_PASSWORD=tu_contraseña
HANA_SCHEMA=tu_schema

# --- HANA (SAP) — Test (switch "Test" del dashboard) ---
HANA_TEST_HOST=hd0-db.cencosud.corp
HANA_TEST_PORT=30015
HANA_TEST_USER=tu_usuario_test
HANA_TEST_PASSWORD=tu_contraseña_test

# --- Autenticacion del dashboard (intranet) ---
GESTOR_PASS=gestor01
REVISOR_PASS=revisor01

# --- Correo diario (envío vía XSJS de HANA) ---
# Los destinatarios salen de la vista HANA
# Z_NCRCO.Log_views.Dashboard_Mail/Log_ReportMailer_Dashboard_DEST.
# Sin direcciones no se envía. El remitente es fijo y el XSJS usa
# HANA_USER/HANA_PASSWORD para Basic Auth.
# URL del XSJS desplegado en HANA (paquete Z_NCRCO/Pos_staging).
# Si el certificado del XS es interno/self-signed, dejar EMAIL_XSJS_VERIFY_TLS=0.
EMAIL_XSJS_URL=https://hl0-db.cencosud.corp:4300/Z_NCRCO/Pos_staging/send_monitor_email.xsjs
EMAIL_XSJS_VERIFY_TLS=0

# --- PostgreSQL (POST) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=post_db
POSTGRES_USER=tu_usuario
POSTGRES_PASSWORD=tu_contraseña

# --- Dashboard ---
STREAMLIT_PORT=8501
